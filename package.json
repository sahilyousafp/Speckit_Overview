    "url": "https://github.com/sahilyousafp/Speckit_Overview/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sahilyousafp/Speckit_Overview.git"
  },
  "license": "MIT",
  "author": "Sahil Yousaf",
  "type": "module",
  "bin": {
    "speckit-overview": "bin/cli.mjs"
  },
  "files": [
    "bin/",
    "lib/",
    "dist/overview-preset.zip",
    "dist/overview-extension.zip",
    "dist/manifest.json"
  ],
  "engines": {
